PORT=3000
JURISPRUDENCIAIA_URL=https://www.jurisprudenciaia.com.br/
REQUEST_TIMEOUT_MS=120000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=4

# OAuth 2.1 com Google. Use apenas dados ficticios neste arquivo versionado.
MCP_PUBLIC_ORIGIN=https://mcp.example.com
MCP_GOOGLE_CALLBACK_ORIGIN=https://mcp.example.com
MCP_GOOGLE_CLIENT_ID=replace-with-public-google-client-id.apps.googleusercontent.com
MCP_GOOGLE_CLIENT_SECRET=replace-in-local-dev-only

# Dado pessoal: configure somente em .dev.vars local ou Worker Secret.
MCP_ALLOWED_EMAILS=usuario.autorizado@example.com

# Opcional: manutencao e smoke tests administrativos, nunca para o usuario final.
MCP_BEARER_TOKEN=replace-in-local-dev-only
MCP_ALLOWED_ORIGINS=
MCP_ICON_URL=
