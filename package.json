{
  "name": "jurisprudenciaia-mcp",
  "version": "0.2.1",
  "description": "Conector MCP auto-hospedado para consultar o JurisprudenciaIA usando Cloudflare Workers.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "npm run cf-types && tsc -p tsconfig.json",
    "deploy:worker": "wrangler deploy",
    "start:server": "node dist/src/server.js",
    "check:chatgpt-oauth": "node scripts/check-chatgpt-oauth.mjs",
    "check:claude-oauth": "node scripts/check-claude-oauth.mjs",
    "check:loopback-oauth": "node scripts/check-loopback-oauth.mjs",
    "verify": "npm run cf-types && npm run typecheck && npm test && npm audit --audit-level=high --omit=dev && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf-types": "wrangler types"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "zod": "4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.136.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.11",
    "body-parser": "2.3.0",
    "esbuild": "0.28.1",
    "fast-uri": "3.1.8",
    "hono": "4.13.7",
    "ip-address": "10.7.1",
    "browserslist": "4.28.7",
    "jose": "6.2.5",
    "proxy-addr": "2.0.8",
    "qs": "6.16.0",
    "zod": "4.6.0",
    "nanoid": "3.3.19"
  },
  "engines": {
    "node": ">=22"
  }
}
